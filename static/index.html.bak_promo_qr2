    async function startBulkPromoScan() {
      const raw = document.getElementById("promo-bulk-input").value.trim();
      if (!raw) return alert("Please enter at least one account to scan!");

      const lines = raw.split('\n').map(l => l.trim()).filter(l => l.length > 0);
      if (!lines.length) return alert("No valid lines found!");

      const coupon = document.getElementById("promo-bulk-coupon").value.trim() || 'plus-1-month-free';
      const concurrency = parseInt(document.getElementById("promo-bulk-concurrency").value, 10) || 2;
      const delaySec = parseFloat(document.getElementById("promo-bulk-delay").value) || 0;

      promoBulkState.running = true;
      promoBulkState.stopRequested = false;
      promoBulkState.total = lines.length;
      promoBulkState.completed = 0;
      promoBulkState.eligible = 0;
      promoBulkState.ineligible = 0;
      promoBulkState.results = [];

      document.getElementById("promo-stat-total").innerText = lines.length;
      document.getElementById("promo-stat-completed").innerText = "0";
      document.getElementById("promo-stat-eligible").innerText = "0";
      document.getElementById("promo-stat-ineligible").innerText = "0";
      document.getElementById("promo-progress-fill").style.width = "0%";

      document.getElementById("btn-promo-bulk-start").disabled = true;
      document.getElementById("btn-promo-bulk-stop").disabled = false;
      const tbody = document.getElementById("promo-bulk-table-body");
      tbody.innerHTML = '';

      let idx = 0;
      const worker = async () => {
        while (idx < lines.length && !promoBulkState.stopRequested) {
          const currentIdx = idx++;
          const line = lines[currentIdx];
          const tr = document.createElement("tr");
          tr.id = `promo-row-${currentIdx}`;
          tr.innerHTML = `
            <td>${currentIdx + 1}</td>
            <td style="font-family:'JetBrains Mono',monospace; font-size:0.8rem;">${escapeHtml(line.split('|')[0] || line.slice(0, 20))}</td>
            <td><span class="badge-pill">...</span></td>
            <td><span class="badge-pill" style="background:#eff6ff; color:#1d4ed8;">Checking...</span></td>
            <td><span class="spinner" style="display:inline-block; width:14px; height:14px;"></span></td>
            <td>-</td>
          `;
          tbody.prepend(tr);

          try {
            const resp = await fetch("/api/promo/check", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ account_input: line, custom_coupon: coupon })
            });
            const data = await resp.json();

            promoBulkState.completed++;
            const isElig = data.ok && data.has_eligible_offers;
            if (isElig) promoBulkState.eligible++;
            else promoBulkState.ineligible++;

            promoBulkState.results.push({ line, data, isElig });

            const row = document.getElementById(`promo-row-${currentIdx}`);
            if (row) {
              const plan = (data.plan_type || 'free').toUpperCase();
              const planClass = plan === 'PLUS' ? 'badge-plus' : 'badge-free';
              let statusPill = `<span class="badge-pill" style="background:#fef2f2; color:#dc2626;">Error</span>`;
              if (data.ok) {
                statusPill = isElig 
                  ? `<span class="badge-pill" style="background:#ecfdf5; color:#059669; border:1px solid #a7f3d0; font-weight:800;">🟢 ELIGIBLE</span>`
                  : `<span class="badge-pill" style="background:#f1f5f9; color:#64748b;">NOT ELIGIBLE</span>`;
              }
              const details = data.ok 
                ? (isElig ? `Eligible for ${data.best_coupon}` : `Checked ${data.coupons ? data.coupons.length : 0} campaigns (${data.elapsed_seconds || 0}s)`)
                : (data.error || 'Check failed');

              row.innerHTML = `
                <td>${currentIdx + 1}</td>
                <td style="font-family:'JetBrains Mono',monospace; font-size:0.8rem;"><b>${escapeHtml(data.email || line.split('|')[0])}</b></td>
                <td><span class="badge-pill ${planClass}">${plan}</span></td>
                <td>${statusPill}</td>
                <td style="font-size:0.82rem; color:#475569;">${escapeHtml(details)}</td>
                <td>
                  ${isElig ? `<button class="btn-tbl-action" onclick="navigator.clipboard.writeText('${data.claim_url}'); showToast('Claim URL copied!');">📋 Link</button>` : `-`}
                </td>
              `;
            }
          } catch (err) {
            promoBulkState.completed++;
            promoBulkState.ineligible++;
            const row = document.getElementById(`promo-row-${currentIdx}`);
            if (row) {
              row.innerHTML = `
                <td>${currentIdx + 1}</td>
                <td>${escapeHtml(line.split('|')[0])}</td>
                <td>-</td>
                <td><span class="badge-pill" style="background:#fef2f2; color:#dc2626;">Failed</span></td>
                <td style="font-size:0.82rem; color:#dc2626;">${escapeHtml(err.message)}</td>
                <td>-</td>
              `;
            }
          }

          document.getElementById("promo-stat-completed").innerText = promoBulkState.completed;
          document.getElementById("promo-stat-eligible").innerText = promoBulkState.eligible;
          document.getElementById("promo-stat-ineligible").innerText = promoBulkState.ineligible;
          const pct = Math.round((promoBulkState.completed / promoBulkState.total) * 100);
          document.getElementById("promo-progress-fill").style.width = pct + "%";

          if (delaySec > 0) {
            await new Promise(r => setTimeout(r, delaySec * 1000));
          }
        }
      };

      const workers = [];
      for (let w = 0; w < concurrency; w++) {
        workers.push(worker());
      }
      await Promise.all(workers);

      promoBulkState.running = false;
      document.getElementById("btn-promo-bulk-start").disabled = false;
      document.getElementById("btn-promo-bulk-stop").disabled = true;
      showToast(`Bulk promo scan complete! Found ${promoBulkState.eligible} eligible accounts.`);
    }

