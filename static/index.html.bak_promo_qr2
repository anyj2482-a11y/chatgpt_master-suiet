            <td style="font-family:'JetBrains Mono'; font-size:0.75rem; color:var(--text-muted);">In Queue</td>
            <td>---</td>
          </tr>
        `;
      }).join('');

      let completedCount = 0;
      let successCount = 0;
      let failedCount = 0;
      let nextIndex = 0;

      async function worker() {
        while (nextIndex < lines.length) {
          if (fastBulkState.stopRequested) break;
          const idx = nextIndex++;
          const line = lines[idx];
          const parts = line.split('|');
          const email = parts[0] || 'Unknown';
          const row = document.getElementById(`fast-row-${idx}`);

          // Set running UI
          if (row) {
            row.cells[4].innerHTML = '<span class="badge-status" style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe;">RUNNING</span>';
            row.cells[5].innerHTML = '<span style="color:#6b21a8;">Solving POW + MFA...</span>';
          }

          let lineProxy = defaultProxy;
          let accLine = line;
          if (parts.length >= 4 && (parts[3].startsWith('http://') || parts[3].startsWith('https://') || parts[3].startsWith('socks5://'))) {
            lineProxy = parts[3];
            accLine = `${parts[0]}|${parts[1]}|${parts[2]}`;
          }

          const t0 = performance.now();
          let itemResult = { index: idx + 1, email: email, line: accLine, status: 'FAILED', result: '', elapsed: 0 };

          try {
            const resp = await fetch("/api/fast_login", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ account_line: accLine, proxy: lineProxy })
            });
            const data = await resp.json();
            const elapsed = ((performance.now() - t0) / 1000).toFixed(2);
            itemResult.elapsed = elapsed;

            if (data.ok) {
              successCount++;
              itemResult.status = 'SUCCESS';
              itemResult.plan = (data.plan_type || 'free').toUpperCase();
              itemResult.access_token = data.access_token || '';
              itemResult.session_token = data.session_token || '';
              itemResult.device_id = data.device_id || '';
              itemResult.result = `${data.account_line || accLine} [Plan: ${itemResult.plan}]`;

              if (row) {
                row.cells[2].innerHTML = `<span class="badge-status" style="background:${itemResult.plan === 'FREE' ? '#e0e7ff' : '#dcfce7'}; color:${itemResult.plan === 'FREE' ? '#3730a3' : '#15803d'}; font-weight:700;">${itemResult.plan}</span>`;
                row.cells[3].innerText = `${elapsed}s`;
                row.cells[4].innerHTML = '<span class="badge-status badge-success">SUCCESS</span>';
                row.cells[5].innerHTML = `<span title="${escapeHtml(itemResult.access_token)}">Token: ${itemResult.access_token.substring(0, 16)}...</span>`;
                row.cells[6].innerHTML = `
                  <div style="display:flex; gap:5px; align-items:center;">
                    <button class="copy-btn" onclick="navigator.clipboard.writeText('${itemResult.access_token}'); showToast('Access token copied!');" style="background:#ede9fe; color:#5b21b6; border-color:#ddd6fe; font-weight:700;" title="Copy Access Token">🔑 Access</button>
                    <button class="copy-btn" onclick="navigator.clipboard.writeText('${escapeHtml(accLine)}'); showToast('Account line copied!');" title="Copy email|pass|2fa">📋 Line</button>
                  </div>
                `;
              }
            } else {
              failedCount++;
              itemResult.error = data.error || 'Login failed';
              if (row) {
                row.cells[2].innerHTML = '<span class="badge-status" style="background:#fee2e2; color:#991b1b;">N/A</span>';
                row.cells[3].innerText = `${elapsed}s`;
                row.cells[4].innerHTML = '<span class="badge-status badge-failed">FAILED</span>';
                row.cells[5].innerHTML = `<span style="color:#dc2626; font-size:0.75rem;" title="${escapeHtml(itemResult.error)}">${escapeHtml(itemResult.error.substring(0, 35))}...</span>`;
                row.cells[6].innerHTML = `<button class="copy-btn" onclick="navigator.clipboard.writeText('${escapeHtml(accLine)}'); showToast('Account line copied!');">📋 Line</button>`;
              }
            }
          } catch (err) {
            failedCount++;
            itemResult.error = err.message;
            if (row) {
              row.cells[3].innerText = `ERR`;
              row.cells[4].innerHTML = '<span class="badge-status badge-failed">ERROR</span>';
              row.cells[5].innerHTML = `<span style="color:#dc2626;">${escapeHtml(err.message)}</span>`;
              row.cells[6].innerHTML = `<button class="copy-btn" onclick="navigator.clipboard.writeText('${escapeHtml(accLine)}'); showToast('Account line copied!');">📋 Line</button>`;
            }
          }

          fastBulkState.results.push(itemResult);
          completedCount++;
          document.getElementById('fast-stat-done').innerText = completedCount;
          document.getElementById('fast-stat-success').innerText = successCount;
          document.getElementById('fast-stat-failed').innerText = failedCount;
          document.getElementById('fast-bulk-progress').style.width = `${Math.round((completedCount / lines.length) * 100)}%`;

          if (delayMs > 0 && !fastBulkState.stopRequested) {
            await new Promise(r => setTimeout(r, delayMs));
          }
        }
      }

      const workers = [];
      for (let i = 0; i < concurrency; i++) workers.push(worker());
      await Promise.all(workers);

      fastBulkState.running = false;
      document.getElementById('fast-bulk-start-btn').disabled = false;
      document.getElementById('fast-bulk-start-btn').innerText = "▶️ Start Bulk Login";
      document.getElementById('fast-bulk-stop-btn').disabled = true;
      document.getElementById('fast-bulk-stop-btn').innerText = "⏹️ Stop";

      if (fastBulkState.stopRequested) {
        showToast(`Runner paused! ${successCount} successful, ${failedCount} failed.`);
      } else {
        showToast(`Bulk Fast Login complete! ${successCount}/${lines.length} successful.`);
      }
    }

