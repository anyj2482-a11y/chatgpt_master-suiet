        msgDiv.innerText = "Error: " + err.message;
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<span>✅ Confirm & Complete Mandate</span>`;
      }
    }

    function copyStripeSessionId() {
      if (!currentCheckoutSessionId) return;
      navigator.clipboard.writeText(currentCheckoutSessionId);
      showToast("Copied Checkout Session ID!");
    }

  </script>
</body>
</html>
