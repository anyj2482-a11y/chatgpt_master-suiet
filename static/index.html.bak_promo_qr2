    async function startFastBulkRunner() {
      if (fastBulkState.running) return;
      const rawText = document.getElementById('fast-bulk-input').value;
      const lines = rawText.split('\n').map(l => l.trim()).filter(l => l && !l.startsWith('#'));
      if (lines.length === 0) return alert("Please enter at least one account line in format: email|password|2fa_secret");

      const defaultProxy = document.getElementById('fast-bulk-proxy').value.trim() || null;
      const concurrency = parseInt(document.getElementById('fast-bulk-concurrency').value, 10) || 1;
      const delayMs = parseInt(document.getElementById('fast-bulk-delay').value, 10) || 0;

      fastBulkState.running = true;
      fastBulkState.stopRequested = false;
      fastBulkState.results = [];

      document.getElementById('fast-bulk-start-btn').disabled = true;
      document.getElementById('fast-bulk-start-btn').innerText = "⏳ Processing...";
      document.getElementById('fast-bulk-stop-btn').disabled = false;
      document.getElementById('fast-bulk-stop-btn').innerText = "⏹️ Stop";

      document.getElementById('fast-stat-total').innerText = lines.length;
      document.getElementById('fast-stat-done').innerText = '0';
      document.getElementById('fast-stat-success').innerText = '0';
      document.getElementById('fast-stat-failed').innerText = '0';
      document.getElementById('fast-bulk-progress').style.width = '0%';

      const tbody = document.getElementById('fast-bulk-table-body');
      tbody.innerHTML = lines.map((line, idx) => {
        const parts = line.split('|');
        const email = parts[0] || `Account #${idx + 1}`;
        return `
          <tr id="fast-row-${idx}">
            <td style="font-weight:700; color:var(--purple-dark);">${idx + 1}</td>
